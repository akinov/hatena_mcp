{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": true, // Explicitly set though covered by strict
    "skipLibCheck": false // Ensure library files are checked
  }
}
